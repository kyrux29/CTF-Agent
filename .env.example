# Compose supplies these values directly. Do not copy this file unchanged for
# host-local uvicorn: `postgres` and `/data` are container-only values. Omit the
# database and artifact variables to use the default host-local SQLite profile.
CTFMESH_ENVIRONMENT=development
# The shell-capable Power profile is opt-in. Keep this false for normal and
# m6-ui deployments; `docker compose --profile power ...` requires true.
CTFMESH_POWER_ENABLED=false
# Required only for Power P1+ private workspace RPC. Generate a unique 32+
# character local capability and keep it only in your uncommitted `.env`.
CTFMESH_SANDBOXD_TOKEN=
# Required for Power P2 flag verification. These are separate 32+ character
# service capabilities; never use an AI provider key for either value.
CTFMESH_INTERNAL_FLAG_ROUTER_TOKEN=
CTFMESH_FLAG_ROUTER_TOKEN=
CTFMESH_BIND_HOST=127.0.0.1
CTFMESH_BIND_PORT=8000
CTFMESH_DATABASE_URL=postgresql+asyncpg://ctfmesh:ctfmesh-dev@postgres:5432/ctfmesh
CTFMESH_ARTIFACT_ROOT=/data/artifacts
# This stays loopback-only in Compose. Change only the local port when another
# trusted local smoke project already uses 5173.
WEB_PORT=5173
CTFMESH_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Required by the Pi runner in the M2 smoke and Power profiles. `just
# power-bootstrap` creates a random local capability unless one already
# exists; it is not an AI-provider API key.
CTFMESH_INTERNAL_RUNNER_TOKEN=
# `fixture` runs the end-to-end control loop without a model/key/target.
CTFMESH_PI_RUNNER_MODE=fixture
# Power retries transient provider/network failures automatically. A retry
# burst is followed by durable job reclaim, so no racer session is marked
# failed solely because a provider briefly disconnects. Keep credentials,
# quota, model-ID and schema failures terminal so they do not burn budget.
CTFMESH_PI_POWER_PROVIDER_RETRY_ATTEMPTS=5
CTFMESH_PI_POWER_PROVIDER_RETRY_BASE_MS=1000
CTFMESH_PI_POWER_PROVIDER_RETRY_MAX_DELAY_MS=30000
# M6.a receives the actual model/provider solely from the one browser launch
# request. Do not put an AI API key or a default model in this file.
# Docker fixes the archive-triage proxy to its reviewed internal service origin.
# Do not override it with a custom proxy URL or place browser/API keys here.
# Required for source tools in the aggregate m3 profile (or m3-source
# diagnostic profile). Set these in your shell or a private deployment secret
# store; the values below intentionally stay blank.
CTFMESH_TOOL_GATEWAY_URL=
CTFMESH_TOOL_GATEWAY_TOKEN=
CTFMESH_SOURCE_SLOT_TOKEN=
# Required for the first challenge. Slot 2 falls back to this same database ID.
CTFMESH_SOURCE_SLOT_1_CHALLENGE_ID=
# Optional: Compose defaults to the fixed sandbox-source-1 service URL.
CTFMESH_SOURCE_SLOT_1_URL=
# Optional: set only when binding a different concurrent challenge to slot 2.
CTFMESH_SOURCE_SLOT_2_CHALLENGE_ID=
# Optional: Compose defaults to the fixed sandbox-source-2 service URL.
CTFMESH_SOURCE_SLOT_2_URL=
# M6.a UI exact-instance lane. These are internal service credentials, not AI
# keys. Generate unique local values (32+ characters for capability key) and
# keep a populated `.env` private. The UI sends Gemini/OpenAI/DeepSeek keys
# per run; they never belong here.
CTFMESH_PI_CREDENTIAL_BROKER_URL=
CTFMESH_TARGET_CAPABILITY_KEY=
CTFMESH_SOURCE_SLOT_1_DYNAMIC_ASSIGNMENT=false
CTFMESH_SOURCE_SLOT_2_DYNAMIC_ASSIGNMENT=false
# When starting `docker compose --profile m6-ui up -d --build`, set both URLs
# below and both dynamic flags to `true`; leave both challenge IDs blank.
# CTFMESH_SOURCE_SLOT_1_URL=http://ui-source-slot-1:8082
# CTFMESH_SOURCE_SLOT_2_URL=http://ui-source-slot-2:8082
# CTFMESH_PI_CREDENTIAL_BROKER_URL=http://pi-runner-live:8090
# Exact DNS hostnames only (no wildcard/IP). This is configuration, never an
# API credential. The blank value lets Compose use its reviewed defaults.
CTFMESH_PROVIDER_PROXY_ALLOWED_HOSTS=
# M5 is an opt-in local verifier/lab profile. Keep all four values in an
# operator secret store or interactive shell, never in a committed .env file.
# The private Ed25519 seed belongs only to lab-controller; verifier receives
# only the matching public key.
CTFMESH_INTERNAL_VERIFIER_TOKEN=
CTFMESH_LAB_CONTROLLER_TOKEN=
CTFMESH_LAB_CONTROLLER_PRIVATE_KEY=
CTFMESH_LAB_CONTROLLER_PUBLIC_KEY=
