{
  "name": "@ctfmesh/tests",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "web:types": "tsc --noEmit -p web/tsconfig.json",
    "web:test": "vitest run --config web/vitest.config.ts",
    "web:check": "pnpm run web:types && pnpm run web:test",
    "pi:types": "tsc --noEmit -p pi-runner/tsconfig.json",
    "pi:test": "vitest run --dir pi-runner",
    "pi:check": "pnpm run pi:types && pnpm run pi:test"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "5.9.3",
    "vite": "^7.1.3",
    "vitest": "3.2.7"
  }
}
