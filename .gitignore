# Local secrets and machine-specific configuration
.env
.env.*
!.env.example
secrets/
*.key
*.pem
*.p12
*.pfx

# Operator-owned challenge material
/challenges/*
!/challenges/.gitkeep

# Operator-owned historical CTF notes; the tracked .gitkeep preserves the
# local-only P7 knowledge root without publishing private writeups or flags.
/knowledge/writeups/*
!/knowledge/writeups/.gitkeep

# Runtime state and generated evidence
.artifacts/
output/
.pi-sessions/
**/.pi-sessions/
*.db
*.db-shm
*.db-wal
*.sqlite3

# Python environments, caches, and packaging output
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.pytype/
.hypothesis/
.tox/
.nox/

# JavaScript dependencies and build output
node_modules/
.pnpm-store/
**/.vite/
*.tsbuildinfo
.turbo/
.cache/
.eslintcache
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test and coverage output
.coverage
.coverage.*
htmlcov/
coverage/
coverage.xml
playwright-report/
test-results/
.playwright-cli/

# Editor, OS, and temporary files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.log
*.tmp
*.bak
